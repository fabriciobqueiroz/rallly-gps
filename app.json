{
  "expo": {
    "name": "Rally GPS Teste",
    "slug": "rally-gps-teste",
    "version": "0.1.0",
    "orientation": "default",
    "android": {
      "package": "br.com.rallysjrp.gpsteste"
    },
    "plugins": [
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permitir que o app use a câmera para fotografar referências do percurso."
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}